            align-items: center;
            justify-content: center;
            background-color: #ffffff;
            transition: all 0.2s ease;
        }
        .custom-checkbox:checked {
            background-color: #ff6600;
            border-color: #ff6600;
        }
        .custom-checkbox:checked::after {
            content: "\f00c";
            font-family: "Font Awesome 6 Free";
