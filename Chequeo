        ];

        window.onload = function() {
            renderTable();
        };

        function parseDate(dateStr) {
            if (!dateStr) return null;
            const parts = dateStr.split('/');
            if (parts.length !== 3) return null;
            const day = parseInt(parts[0], 10);
            const month = parseInt(parts[1], 10) - 1;
            const year = parseInt(parts[2], 10);
            return new Date(year, month, day);
        }

        function getFilteredOrders() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const statusFilter = document.getElementById('statusFilter').value;
            const dateFilter = document.getElementById('dateFilter').value;

            const today = new Date();
            today.setHours(0,0,0,0);

            return orders.filter((order, idx) => {
                order.originalIndex = idx;
                
                // Búsqueda
                const matchSearch = order.cliente.toLowerCase().includes(search) ||
                                    order.pedido.toLowerCase().includes(search) ||
                                    order.factura.toLowerCase().includes(search);
                if (!matchSearch) return false;

                // Cálculo de estado
                const stepsCount = [order.s1, order.s2, order.s3, order.s4, order.s5].filter(Boolean).length;
                let status = 'Pendiente';
                if (stepsCount === 5) status = 'Completado';
                else if (stepsCount > 0) status = 'En Proceso';

                // Filtro de estado
                if (statusFilter !== 'TODOS' && status !== statusFilter) return false;

                // Filtro de fecha
                const orderDate = parseDate(order.fecha);
                if (dateFilter === 'HOY' && orderDate) {
                    orderDate.setHours(0,0,0,0);
                    if (orderDate.getTime() !== today.getTime()) return false;
                } else if (dateFilter === 'MES' && orderDate) {
                    if (orderDate.getMonth() !== today.getMonth() || orderDate.getFullYear() !== today.getFullYear()) return false;
                }

                return true;
            });
        }

        function renderTable() {
            const tbody = document.getElementById('ordersTableBody');
            tbody.innerHTML = '';

            const filtered = getFilteredOrders();

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="13" class="text-center py-8 text-slate-400 font-medium">No se encontraron pedidos registrados</td></tr>`;
                updateKPIs(orders);
                return;
            }

            filtered.forEach((order) => {
                const i = order.originalIndex;
                const stepsCount = [order.s1, order.s2, order.s3, order.s4, order.s5].filter(Boolean).length;
                const percentage = stepsCount * 20;

                let statusText = 'Pendiente';
                let statusBadge = 'bg-slate-100 text-slate-700 border-slate-200';
                if (percentage === 100) {
                    statusText = 'Completado';
                    statusBadge = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                } else if (percentage > 0) {
                    statusText = 'En Proceso';
                    statusBadge = 'bg-orange-50 text-orange-700 border-orange-200';
                }

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition-colors border-b border-slate-200";
                tr.innerHTML = `
                    <td class="py-2.5 px-3 font-medium border-r border-slate-200">${order.fecha}</td>
                    <td class="py-2.5 px-3 font-bold text-slate-900 border-r border-slate-200">${order.pedido}</td>
                    <td class="py-2.5 px-3 font-mono text-[11px] text-slate-600 border-r border-slate-200">${order.factura}</td>
                    <td class="py-2.5 px-3 font-semibold text-slate-900 border-r border-slate-200">${order.cliente}</td>
                    
                    <td class="py-2.5 px-2 text-center border-r border-slate-200"><input type="checkbox" class="custom-checkbox" ${order.s1 ? 'checked' : ''} onchange="toggleStep(${i}, 's1', this.checked)"></td>
                    <td class="py-2.5 px-2 text-center border-r border-slate-200"><input type="checkbox" class="custom-checkbox" ${order.s2 ? 'checked' : ''} onchange="toggleStep(${i}, 's2', this.checked)"></td>
                    <td class="py-2.5 px-2 text-center border-r border-slate-200"><input type="checkbox" class="custom-checkbox" ${order.s3 ? 'checked' : ''} onchange="toggleStep(${i}, 's3', this.checked)"></td>
                    <td class="py-2.5 px-2 text-center border-r border-slate-200"><input type="checkbox" class="custom-checkbox" ${order.s4 ? 'checked' : ''} onchange="toggleStep(${i}, 's4', this.checked)"></td>
                    <td class="py-2.5 px-2 text-center border-r border-slate-200"><input type="checkbox" class="custom-checkbox" ${order.s5 ? 'checked' : ''} onchange="toggleStep(${i}, 's5', this.checked)"></td>
                    
                    <td class="py-2.5 px-3 border-r border-slate-200">
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-slate-800 text-xs w-9 text-right">${percentage}%</span>
                            <div class="w-full bg-slate-200 rounded-full h-2 overflow-hidden">
                                <div class="bg-orange-500 h-2 rounded-full transition-all duration-300" style="width: ${percentage}%"></div>
                            </div>
                        </div>
                    </td>
                    <td class="py-2.5 px-3 border-r border-slate-200">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold border ${statusBadge}">
                            ${statusText}
                        </span>
                    </td>
                    <td class="py-2.5 px-3 border-r border-slate-200">
                        <input type="text" value="${order.obs || ''}" onchange="updateObs(${i}, this.value)" placeholder="Agregar nota..." 
                            class="w-full px-2 py-1 text-xs border border-slate-200 rounded focus:border-orange-500 outline-none bg-transparent">
                    </td>
                    <td class="py-2.5 px-3 text-center action-col">
                        <div class="flex items-center justify-center gap-1.5">
                            <button onclick="editOrder(${i})" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded transition" title="Editar">
                                <i class="fa-solid fa-pen text-xs"></i>
                            </button>
                            <button onclick="promptDelete('${order.pedido}', '${order.cliente}')" class="p-1.5 text-red-600 hover:bg-red-50 rounded transition" title="Eliminar">
                                <i class="fa-solid fa-trash text-xs"></i>
                            </button>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            updateKPIs(orders);
        }

        function toggleStep(index, stepKey, value) {
            orders[index][stepKey] = value;
            renderTable();
        }

        function updateObs(index, val) {
            orders[index].obs = val;
            showToast('Observación actualizada');
        }

        function updateKPIs(data) {
            const total = data.length;
            let completed = 0;
            let inProcess = 0;
            let totalPercentage = 0;

            data.forEach(order => {
                const stepsCount = [order.s1, order.s2, order.s3, order.s4, order.s5].filter(Boolean).length;
                const pct = stepsCount * 20;
                totalPercentage += pct;
                if (pct === 100) completed++;
                else if (pct > 0) inProcess++;
            });

            const globalAvg = total > 0 ? Math.round(totalPercentage / total) : 0;

            document.getElementById('kpi-total').innerText = total;
            document.getElementById('kpi-completados').innerText = completed;
            document.getElementById('kpi-proceso').innerText = inProcess;
            document.getElementById('kpi-cumplimiento').innerText = globalAvg + '%';
        }

        function openModal() {
            document.getElementById('modalTitle').innerHTML = `<i class="fa-solid fa-folder-plus text-orange-400"></i> Nuevo Pedido`;
            document.getElementById('editIndex').value = -1;
            document.getElementById('orderForm').reset();
            
            const now = new Date();
            const d = String(now.getDate()).padStart(2, '0');
            const m = String(now.getMonth() + 1).padStart(2, '0');
            const y = now.getFullYear();
            document.getElementById('fecha').value = `${d}/${m}/${y}`;
            document.getElementById('pedido').value = `PED-${orders.length + 1}`;

            document.getElementById('orderModal').classList.remove('hidden');
        }

        function editOrder(index) {
            const order = orders[index];
            document.getElementById('modalTitle').innerHTML = `<i class="fa-solid fa-pen-to-square text-orange-400"></i> Editar Pedido`;
            document.getElementById('editIndex').value = index;
            document.getElementById('fecha').value = order.fecha;
            document.getElementById('pedido').value = order.pedido;
            document.getElementById('factura').value = order.factura;
            document.getElementById('cliente').value = order.cliente;
            document.getElementById('observaciones').value = order.obs;

            document.getElementById('orderModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('orderModal').classList.add('hidden');
        }

        function saveOrder(event) {
            event.preventDefault();
            const index = parseInt(document.getElementById('editIndex').value, 10);
            
            const newOrderData = {
                fecha: document.getElementById('fecha').value,
                pedido: document.getElementById('pedido').value,
                factura: document.getElementById('factura').value,
                cliente: document.getElementById('cliente').value.toUpperCase(),
                obs: document.getElementById('observaciones').value,
                s1: index === -1 ? false : orders[index].s1,
                s2: index === -1 ? false : orders[index].s2,
                s3: index === -1 ? false : orders[index].s3,
                s4: index === -1 ? false : orders[index].s4,
                s5: index === -1 ? false : orders[index].s5
            };

            if (index === -1) {
                orders.unshift(newOrderData);
                showToast('Pedido registrado con éxito');
            } else {
                orders[index] = newOrderData;
                showToast('Pedido actualizado con éxito');
            }

            closeModal();
            renderTable();
        }

        // Sistema de borrado seguro mediante modal personalizado
        function promptDelete(pedidoNum, clienteNombre) {
            document.getElementById('deleteTargetNumber').value = pedidoNum;
            document.getElementById('deleteModalText').innerText = `¿Estás seguro de eliminar el pedido ${pedidoNum} (${clienteNombre})?`;
            document.getElementById('deleteModal').classList.remove('hidden');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.add('hidden');
            document.getElementById('deleteTargetNumber').value = '';
        }

        function confirmDelete() {
            const pedidoNum = document.getElementById('deleteTargetNumber').value;
            const index = orders.findIndex(o => o.pedido === pedidoNum);
            
            if (index !== -1) {
                orders.splice(index, 1);
                renderTable();
                showToast('Pedido eliminado correctamente');
            } else {
                showToast('No se encontró el pedido a eliminar');
            }
            closeDeleteModal();
        }

        function downloadPDF() {
            showToast('Generando archivo PDF...');
            
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('landscape', 'mm', 'a4');
            
            // Colores corporativos
            const jadeverDark = [0, 77, 37];
            const orangeAccent = [255, 102, 0];
            
            // Encabezado del PDF
            doc.setFillColor(jadeverDark[0], jadeverDark[1], jadeverDark[2]);
            doc.rect(14, 10, 269, 18, 'F');
            
            doc.setTextColor(255, 255, 255);
            doc.setFont('Inter', 'bold');
            doc.setFontSize(14);
            doc.text("CONTROL DE PEDIDOS JADEVER", 18, 21);
            
            const dateFilterVal = document.getElementById('dateFilter').value;
            let filterText = 'Todos los registros';
            if (dateFilterVal === 'HOY') filterText = 'Filtro: Día de Hoy';
            if (dateFilterVal === 'MES') filterText = 'Filtro: Mes Actual';
            
            const now = new Date();
            const dateStr = now.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
            
            doc.setFontSize(9);
            doc.setFont('Inter', 'normal');
            doc.text(filterText + ' | Fecha de emisión: ' + dateStr, 275, 21, { align: 'right' });

            // Obtener filas filtradas actuales
            const filteredOrders = getFilteredOrders();
            
            const tableRows = filteredOrders.map(order => {
                const stepsCount = [order.s1, order.s2, order.s3, order.s4, order.s5].filter(Boolean).length;
                const percentage = stepsCount * 20;
                let statusText = percentage === 100 ? 'Completado' : (percentage > 0 ? 'En Proceso' : 'Pendiente');
                
                return [
                    order.fecha,
                    order.pedido,
                    order.factura,
                    order.cliente,
                    order.s1 ? '[X]' : '[ ]',
                    order.s2 ? '[X]' : '[ ]',
                    order.s3 ? '[X]' : '[ ]',
                    order.s4 ? '[X]' : '[ ]',
                    order.s5 ? '[X]' : '[ ]',
                    percentage + '%',
                    statusText,
                    order.obs || ''
                ];
            });

            doc.autoTable({
                startY: 32,
                head: [[
                    'Fecha', 'Nº Pedido', 'Factura', 'Cliente', 
                    '1. Orden', '2. Proceso', '3. Final.', '4. Verif.', '5. Entr.', 
                    '% Cumpl.', 'Estado', 'Observaciones'
                ]],
                body: tableRows,
                theme: 'grid',
                headStyles: {
                    fillColor: jadeverDark,
                    textColor: [255, 255, 255],
                    fontSize: 9,
                    fontStyle: 'bold',
                    halign: 'center'
                },
                columnStyles: {
                    0: { cellWidth: 22, halign: 'center' },
                    1: { cellWidth: 22, halign: 'center', fontStyle: 'bold' },
                    2: { cellWidth: 32 },
                    3: { cellWidth: 45 },
                    4: { cellWidth: 18, halign: 'center' },
                    5: { cellWidth: 18, halign: 'center' },
                    6: { cellWidth: 18, halign: 'center' },
                    7: { cellWidth: 18, halign: 'center' },
                    8: { cellWidth: 18, halign: 'center' },
                    9: { cellWidth: 22, halign: 'center', fontStyle: 'bold' },
                    10: { cellWidth: 24, halalign: 'center' },
                    11: { cellWidth: 'auto' }
                },
                styles: {
                    fontSize: 8,
                    textColor: [50, 50, 50],
                    cellPadding: 2.5
                },
                alternateRowStyles: {
                    fillColor: [248, 250, 252]
                }
            });

            // Descargar archivo PDF directamente
            doc.save(`Control_Pedidos_Jadever_${dateFilterVal}_${now.toISOString().slice(0,10)}.pdf`);
            showToast('¡Informe PDF descargado con éxito!');
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMessage').innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>
